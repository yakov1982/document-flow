// Пример HTTP-клиента для DIGITAL_DOCUMENTS_MVP (FastAPI)
// Предназначен как "вставить и адаптировать" в общий модуль конфигурации 1С.
//
// Поддержано:
// - POST /auth/token (x-www-form-urlencoded) -> access_token
// - GET  /auth/me
// - GET  /documents?q=...&status_filter=...
// - GET  /tasks/my
// - POST /documents/{id}/approve|reject (comment как form field)
//
// Внимание:
// - Для методов, где backend принимает файл (multipart), здесь сделана заготовка только под form-data без файла.
// - Для продакшена добавьте обработку ошибок/ретраи/таймауты/логирование.

// =====================================================================================
// Публичный API
// =====================================================================================

Функция Создать(Хост, Порт, ИспользоватьHTTPS, ТаймаутСек=30) Экспорт
	
	Клиент = Новый Структура;
	Клиент.Вставить("Host", Хост);
	Клиент.Вставить("Port", Порт);
	Клиент.Вставить("UseHttps", ИспользоватьHTTPS);
	Клиент.Вставить("TimeoutSec", ТаймаутСек);
	
	Возврат Клиент;
	
КонецФункции


Функция ПолучитьТокен(Клиент, ИмяПользователя, Пароль) Экспорт
	
	// POST /auth/token (OAuth2PasswordRequestForm)
	Тело = "username=" + _UrlEncode(ИмяПользователя) + "&password=" + _UrlEncode(Пароль);
	
	Ответ = _ВыполнитьЗапрос(
		Клиент,
		"POST",
		"/auth/token",
		Неопределено,
		Тело,
		Новый Соответствие("Content-Type", "application/x-www-form-urlencoded")
	);
	
	Данные = _JsonParse(Ответ.Тело);
	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("access_token") Тогда
		Возврат Данные.access_token;
	КонецЕсли;
	
	ВызватьИсключение "Не удалось получить токен (нет access_token в ответе).";
	
КонецФункции


Функция Я(Клиент, Токен) Экспорт
	// GET /auth/me
	Ответ = _ВыполнитьЗапрос(Клиент, "GET", "/auth/me", Токен);
	Возврат _JsonParse(Ответ.Тело);
КонецФункции


Функция СписокДокументов(Клиент, Токен, Поиск="", Статус="") Экспорт
	
	Параметры = Новый Соответствие;
	Если ЗначениеЗаполнено(Поиск) Тогда
		Параметры.Вставить("q", Поиск);
	КонецЕсли;
	Если ЗначениеЗаполнено(Статус) Тогда
		Параметры.Вставить("status_filter", Статус);
	КонецЕсли;
	
	Путь = "/documents" + _BuildQuery(Параметры);
	Ответ = _ВыполнитьЗапрос(Клиент, "GET", Путь, Токен);
	Возврат _JsonParse(Ответ.Тело);
	
КонецФункции


Функция МоиЗадачи(Клиент, Токен) Экспорт
	// GET /tasks/my
	Ответ = _ВыполнитьЗапрос(Клиент, "GET", "/tasks/my", Токен);
	Возврат _JsonParse(Ответ.Тело);
КонецФункции


Функция Согласовать(Клиент, Токен, ИДДокумента, Комментарий="") Экспорт
	Возврат _ОтправитьРешение(Клиент, Токен, ИДДокумента, "approve", Комментарий);
КонецФункции


Функция Отклонить(Клиент, Токен, ИДДокумента, Комментарий="") Экспорт
	Возврат _ОтправитьРешение(Клиент, Токен, ИДДокумента, "reject", Комментарий);
КонецФункции


// =====================================================================================
// Внутренние функции
// =====================================================================================

Функция _ОтправитьРешение(Клиент, Токен, ИДДокумента, Действие, Комментарий) Экспорт
	
	Путь = "/documents/" + Строка(ИДДокумента) + "/" + Действие;
	
	// backend принимает comment как Form() (подойдёт x-www-form-urlencoded)
	Тело = "";
	Если ЗначениеЗаполнено(Комментарий) Тогда
		Тело = "comment=" + _UrlEncode(Комментарий);
	КонецЕсли;
	
	Заголовки = Новый Соответствие("Content-Type", "application/x-www-form-urlencoded");
	Ответ = _ВыполнитьЗапрос(Клиент, "POST", Путь, Токен, Тело, Заголовки);
	Возврат _JsonParse(Ответ.Тело);
	
КонецФункции


Функция _ВыполнитьЗапрос(Клиент, Метод, Путь, Токен=Неопределено, ТелоСтрока=Неопределено, Заголовки=Неопределено)
	
	Соединение = _СоздатьСоединение(Клиент);
	Запрос = Новый HTTPЗапрос(Путь);
	
	// Таймаут: задаём на соединении, но многие используют параметр в конструкторе HTTPСоединение.
	// Дополнительно можно задать заголовки и тело.
	
	Если Заголовки <> Неопределено Тогда
		Для Каждого К Из Заголовки Цикл
			Запрос.Заголовки.Вставить(К.Ключ, К.Значение);
		КонецЦикла;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Токен) Тогда
		Запрос.Заголовки.Вставить("Authorization", "Bearer " + Токен);
	КонецЕсли;
	
	Если ТелоСтрока <> Неопределено Тогда
		Запрос.УстановитьТелоИзСтроки(ТелоСтрока, "UTF-8");
	КонецЕсли;
	
	// Наиболее совместимый вариант: задаём метод в HTTPЗапрос и вызываем Выполнить().
	Запрос.Метод = Метод;
	HTTPОтвет = Соединение.Выполнить(Запрос);
	
	ТелоОтвета = "";
	Попытка
		ТелоОтвета = HTTPОтвет.ПолучитьТелоКакСтроку();
	Исключение
		ТелоОтвета = "";
	КонецПопытки;
	
	Если HTTPОтвет.КодСостояния < 200 ИЛИ HTTPОтвет.КодСостояния >= 300 Тогда
		Текст = "HTTP " + Строка(HTTPОтвет.КодСостояния);
		Если ЗначениеЗаполнено(ТелоОтвета) Тогда
			Текст = Текст + ": " + ТелоОтвета;
		КонецЕсли;
		ВызватьИсключение Текст;
	КонецЕсли;
	
	Рез = Новый Структура;
	Рез.Вставить("КодСостояния", HTTPОтвет.КодСостояния);
	Рез.Вставить("Тело", ТелоОтвета);
	Возврат Рез;
	
КонецФункции


Функция _СоздатьСоединение(Клиент)
	
	Хост = Клиент.Host;
	Порт = Клиент.Port;
	Таймаут = Клиент.TimeoutSec;
	HTTPS = Клиент.UseHttps;
	
	// В разных версиях платформы конструктор/параметры могут отличаться.
	// Универсально: (Хост, Порт, Пользователь, Пароль, Прокси, ЗащищенноеСоединение, Таймаут)
	Возврат Новый HTTPСоединение(Хост, Порт, , , , HTTPS, Таймаут);
	
КонецФункции


Функция _JsonParse(СтрокаJSON)
	
	Если НЕ ЗначениеЗаполнено(СтрокаJSON) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Читатель = Новый ЧтениеJSON;
	Читатель.УстановитьСтроку(СтрокаJSON);
	Возврат ПрочитатьJSON(Читатель);
	
КонецФункции


Функция _UrlEncode(Значение)
	Возврат КодироватьСтроку(Строка(Значение), СпособКодированияСтроки.URLКодирование);
КонецФункции


Функция _BuildQuery(Параметры)
	
	Если Параметры = Неопределено Или Параметры.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Части = Новый Массив;
	Для Каждого К Из Параметры Цикл
		Части.Добавить(_UrlEncode(К.Ключ) + "=" + _UrlEncode(К.Значение));
	КонецЦикла;
	
	Возврат "?" + СтрСоединить(Части, "&");
	
КонецФункции

