////////////////////////////////////////////////////////////////////////////////
// Общая форма «ФормаСогласования»
// Принятие решения по согласованию документа:
//   - Согласовать / Отклонить / На доработку
//   - Ввод комментария
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Документ") Тогда
		ДокументСсылка = Параметры.Документ;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	// Отображаем информацию о документе
	Заголовок = "Согласование: " + Строка(ДокументСсылка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Согласовать(Команда)
	
	СогласоватьНаСервере(
		Перечисления.РезультатыСогласования.Согласовано,
		Комментарий);
	
	Оповестить("ДокументСогласован", ДокументСсылка);
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура Отклонить(Команда)
	
	Если НЕ ЗначениеЗаполнено(Комментарий) Тогда
		ПоказатьПредупреждение(, "При отклонении необходимо указать комментарий.");
		Возврат;
	КонецЕсли;
	
	СогласоватьНаСервере(
		Перечисления.РезультатыСогласования.ОтклоненоСЗамечаниями,
		Комментарий);
	
	Оповестить("ДокументОтклонен", ДокументСсылка);
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура НаДоработку(Команда)
	
	Если НЕ ЗначениеЗаполнено(Комментарий) Тогда
		ПоказатьПредупреждение(, "При возврате на доработку необходимо указать комментарий.");
		Возврат;
	КонецЕсли;
	
	СогласоватьНаСервере(
		Перечисления.РезультатыСогласования.НаДоработку,
		Комментарий);
	
	Оповестить("ДокументОтклонен", ДокументСсылка);
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СогласоватьНаСервере(Результат, ТекстКомментария)
	
	ДокументооборотСервер.ОбработатьРешениеСогласующего(
		ДокументСсылка,
		Результат,
		ТекстКомментария);
	
КонецПроцедуры

#КонецОбласти
