#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДобавитьЭтап(Команда)
	
	// Определяем следующий номер этапа
	МаксНомер = 0;
	Для Каждого Строка Из Объект.ЭтапыМаршрута Цикл
		Если Строка.НомерЭтапа > МаксНомер Тогда
			МаксНомер = Строка.НомерЭтапа;
		КонецЕсли;
	КонецЦикла;
	
	НоваяСтрока = Объект.ЭтапыМаршрута.Добавить();
	НоваяСтрока.НомерЭтапа  = МаксНомер + 1;
	НоваяСтрока.СрокДней     = 3; // по умолчанию 3 рабочих дня
	НоваяСтрока.Обязательный = Истина;
	
КонецПроцедуры

#КонецОбласти
