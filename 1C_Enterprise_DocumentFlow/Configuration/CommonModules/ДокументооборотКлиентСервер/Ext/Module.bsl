// Функции, доступные и на клиенте, и на сервере:
//   - Валидация реквизитов
//   - Формирование представлений
//   - Проверки состояний
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Проверяет, можно ли отправить документ на согласование.
//
// Параметры:
//   Статус - ПеречислениеСсылка.СтатусыДокументов
//
// Возвращаемое значение:
//   Булево
//
Функция МожноОтправитьНаСогласование(Статус) Экспорт
	
	Возврат Статус = ПредопределенноеЗначение("Перечисление.СтатусыДокументов.Черновик")
		ИЛИ Статус = ПредопределенноеЗначение("Перечисление.СтатусыДокументов.Зарегистрирован")
		ИЛИ Статус = ПредопределенноеЗначение("Перечисление.СтатусыДокументов.НаДоработке");
	
КонецФункции

// Проверяет, можно ли зарегистрировать документ.
//
// Параметры:
//   Статус - ПеречислениеСсылка.СтатусыДокументов
//
// Возвращаемое значение:
//   Булево
//
Функция МожноЗарегистрировать(Статус) Экспорт
	
	Возврат Статус = ПредопределенноеЗначение("Перечисление.СтатусыДокументов.Черновик")
		ИЛИ Статус = ПредопределенноеЗначение("Перечисление.СтатусыДокументов.НаРегистрации");
	
КонецФункции

// Проверяет, находится ли документ на согласовании.
//
// Параметры:
//   Статус - ПеречислениеСсылка.СтатусыДокументов
//
// Возвращаемое значение:
//   Булево
//
Функция ДокументНаСогласовании(Статус) Экспорт
	
	Возврат Статус = ПредопределенноеЗначение("Перечисление.СтатусыДокументов.НаСогласовании");
	
КонецФункции

// Формирует текстовое представление документа для отображения в списках.
//
// Параметры:
//   ВидДокумента - Строка - наименование вида документа
//   Номер        - Строка - номер документа
//   Дата         - Дата   - дата документа
//   Заголовок    - Строка - заголовок
//
// Возвращаемое значение:
//   Строка
//
Функция ПредставлениеДокумента(ВидДокумента, Номер, Дата, Заголовок) Экспорт
	
	Результат = "";
	
	Если ЗначениеЗаполнено(ВидДокумента) Тогда
		Результат = Строка(ВидДокумента);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Номер) Тогда
		Если ЗначениеЗаполнено(Результат) Тогда
			Результат = Результат + " ";
		КонецЕсли;
		Результат = Результат + "№" + СокрЛП(Номер);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Дата) Тогда
		Результат = Результат + " от " + Формат(Дата, "ДЛФ=Д");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Заголовок) Тогда
		Если ЗначениеЗаполнено(Результат) Тогда
			Результат = Результат + " — ";
		КонецЕсли;
		Результат = Результат + Заголовок;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает текстовое описание статуса.
//
// Параметры:
//   Статус - ПеречислениеСсылка.СтатусыДокументов
//
// Возвращаемое значение:
//   Строка
//
Функция ОписаниеСтатуса(Статус) Экспорт
	
	Если Статус = ПредопределенноеЗначение("Перечисление.СтатусыДокументов.Черновик") Тогда
		Возврат "Документ в стадии подготовки. Можно редактировать, зарегистрировать или отправить на согласование.";
	ИначеЕсли Статус = ПредопределенноеЗначение("Перечисление.СтатусыДокументов.НаРегистрации") Тогда
		Возврат "Документ ожидает регистрации делопроизводителем.";
	ИначеЕсли Статус = ПредопределенноеЗначение("Перечисление.СтатусыДокументов.Зарегистрирован") Тогда
		Возврат "Документ зарегистрирован. Можно отправить на согласование.";
	ИначеЕсли Статус = ПредопределенноеЗначение("Перечисление.СтатусыДокументов.НаСогласовании") Тогда
		Возврат "Документ проходит процедуру согласования.";
	ИначеЕсли Статус = ПредопределенноеЗначение("Перечисление.СтатусыДокументов.Согласован") Тогда
		Возврат "Документ полностью согласован всеми участниками маршрута.";
	ИначеЕсли Статус = ПредопределенноеЗначение("Перечисление.СтатусыДокументов.Отклонен") Тогда
		Возврат "Документ отклонён одним из согласующих.";
	ИначеЕсли Статус = ПредопределенноеЗначение("Перечисление.СтатусыДокументов.НаДоработке") Тогда
		Возврат "Документ возвращён автору на доработку.";
	ИначеЕсли Статус = ПредопределенноеЗначение("Перечисление.СтатусыДокументов.Архив") Тогда
		Возврат "Документ перемещён в архив.";
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

// Проверяет корректность заполнения основных реквизитов документа.
//
// Параметры:
//   ВидДокумента - ПеречислениеСсылка / СправочникСсылка - вид
//   Заголовок    - Строка
//
// Возвращаемое значение:
//   Массив строк с описаниями ошибок (пустой, если всё ок)
//
Функция ПроверитьЗаполнениеДокумента(ВидДокумента, Заголовок) Экспорт
	
	Ошибки = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(ВидДокумента) Тогда
		Ошибки.Добавить("Не указан вид документа.");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Заголовок) Тогда
		Ошибки.Добавить("Не указан заголовок документа.");
	КонецЕсли;
	
	Возврат Ошибки;
	
КонецФункции

// Возвращает цвет для визуального отображения статуса документа.
//
// Параметры:
//   Статус - ПеречислениеСсылка.СтатусыДокументов
//
// Возвращаемое значение:
//   Цвет
//
Функция ЦветСтатуса(Статус) Экспорт
	
	Если Статус = ПредопределенноеЗначение("Перечисление.СтатусыДокументов.Согласован") Тогда
		Возврат Новый Цвет(0, 128, 0); // зелёный
	ИначеЕсли Статус = ПредопределенноеЗначение("Перечисление.СтатусыДокументов.Отклонен") Тогда
		Возврат Новый Цвет(200, 0, 0); // красный
	ИначеЕсли Статус = ПредопределенноеЗначение("Перечисление.СтатусыДокументов.НаСогласовании") Тогда
		Возврат Новый Цвет(0, 0, 200); // синий
	ИначеЕсли Статус = ПредопределенноеЗначение("Перечисление.СтатусыДокументов.НаДоработке") Тогда
		Возврат Новый Цвет(200, 128, 0); // оранжевый
	Иначе
		Возврат Новый Цвет(80, 80, 80); // серый
	КонецЕсли;
	
КонецФункции

#КонецОбласти
