#Область ПрограммныйИнтерфейс

// Формирует регистрационный номер для документа.
//
// Параметры:
//   ДокументОбъект - ДокументОбъект - объект документа (ВходящийДокумент, ИсходящийДокумент, ВнутреннийДокумент)
//
// Возвращаемое значение:
//   Строка - сформированный регистрационный номер
//
Функция СформироватьРегистрационныйНомер(ДокументОбъект) Экспорт
	
	ВидДокумента = ДокументОбъект.ВидДокумента;
	Префикс = "";
	
	Если ЗначениеЗаполнено(ВидДокумента) Тогда
		Префикс = ВидДокумента.ПрефиксНомера;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Префикс) Тогда
		ИмяДокумента = ДокументОбъект.Метаданные().Имя;
		Если ИмяДокумента = "ВходящийДокумент" Тогда
			Префикс = "ВХ-";
		ИначеЕсли ИмяДокумента = "ИсходящийДокумент" Тогда
			Префикс = "ИСХ-";
		ИначеЕсли ИмяДокумента = "ВнутреннийДокумент" Тогда
			Префикс = "ВН-";
		Иначе
			Префикс = "ДОК-";
		КонецЕсли;
	КонецЕсли;
	
	// Порядковый номер в текущем году
	ТекГод = Год(ТекущаяДатаСеанса());
	НачалоГода = Дата(ТекГод, 1, 1);
	КонецГода  = Дата(ТекГод, 12, 31, 23, 59, 59);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Кол
		|ИЗ
		|	РегистрСведений.ЖурналАудита КАК Ж
		|ГДЕ
		|	Ж.Действие = &Действие
		|	И Ж.Период МЕЖДУ &НачалоГода И &КонецГода";
	Запрос.УстановитьПараметр("Действие",    "Регистрация");
	Запрос.УстановитьПараметр("НачалоГода",  НачалоГода);
	Запрос.УстановитьПараметр("КонецГода",   КонецГода);
	
	Выборка = Запрос.Выполнить().Выбрать();
	НомерПорядковый = 1;
	Если Выборка.Следующий() Тогда
		НомерПорядковый = Выборка.Кол + 1;
	КонецЕсли;
	
	Возврат Префикс + Формат(НомерПорядковый, "ЧЦ=6; ЧВН=; ЧГ=0") + "/" + Формат(ТекГод, "ЧГ=0");
	
КонецФункции

// Регистрирует документ: присваивает номер, ставит статус «Зарегистрирован», пишет аудит.
//
// Параметры:
//   ДокументСсылка - ДокументСсылка - ссылка на документ
//
Процедура ЗарегистрироватьДокумент(ДокументСсылка) Экспорт
	
	НачатьТранзакцию();
	Попытка
		ДокОбъект = ДокументСсылка.ПолучитьОбъект();
		ДокОбъект.Заблокировать();
		
		ДокОбъект.РегистрационныйНомер = СформироватьРегистрационныйНомер(ДокОбъект);
		ДокОбъект.ДатаРегистрации      = ТекущаяДатаСеанса();
		ДокОбъект.Статус                = Перечисления.СтатусыДокументов.Зарегистрирован;
		
		ДокОбъект.Записать();
		
		ЗаписатьАудит(ДокументСсылка, "Регистрация",
			"Присвоен номер: " + ДокОбъект.РегистрационныйНомер);
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Отправляет документ на согласование по указанному шаблону маршрута.
//
// Параметры:
//   ДокументСсылка  - ДокументСсылка - ссылка на документ
//   ШаблонМаршрута  - СправочникСсылка.ШаблоныМаршрутов - шаблон маршрута
//
Процедура ОтправитьНаСогласование(ДокументСсылка, ШаблонМаршрута = Неопределено) Экспорт
	
	НачатьТранзакцию();
	Попытка
		ДокОбъект = ДокументСсылка.ПолучитьОбъект();
		ДокОбъект.Заблокировать();
		
		// Определяем шаблон маршрута
		ТекШаблон = ШаблонМаршрута;
		Если НЕ ЗначениеЗаполнено(ТекШаблон) Тогда
			ТекШаблон = ДокОбъект.ШаблонМаршрута;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТекШаблон) И ЗначениеЗаполнено(ДокОбъект.ВидДокумента) Тогда
			ТекШаблон = ДокОбъект.ВидДокумента.ШаблонМаршрута;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТекШаблон) Тогда
			ВызватьИсключение "Не задан шаблон маршрута согласования.";
		КонецЕсли;
		
		// Заполняем маршрут из шаблона
		ДокОбъект.МаршрутСогласования.Очистить();
		
		Для Каждого Этап Из ТекШаблон.ЭтапыМаршрута Цикл
			НоваяСтрока = ДокОбъект.МаршрутСогласования.Добавить();
			НоваяСтрока.НомерЭтапа  = Этап.НомерЭтапа;
			НоваяСтрока.Согласующий  = Этап.Согласующий;
			НоваяСтрока.СрокДней     = Этап.СрокДней;
		КонецЦикла;
		
		ДокОбъект.ТекущийЭтапСогласования = 1;
		ДокОбъект.Статус = Перечисления.СтатусыДокументов.НаСогласовании;
		ДокОбъект.ШаблонМаршрута = ТекШаблон;
		
		ДокОбъект.Записать();
		
		ЗаписатьАудит(ДокументСсылка, "ОтправкаНаСогласование",
			"Маршрут: " + Строка(ТекШаблон) + ", этапов: " + ДокОбъект.МаршрутСогласования.Количество());
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Обрабатывает решение согласующего на текущем этапе.
//
// Параметры:
//   ДокументСсылка - ДокументСсылка - ссылка на документ
//   Результат      - ПеречислениеСсылка.РезультатыСогласования - решение
//   Комментарий    - Строка - комментарий согласующего
//
Процедура ОбработатьРешениеСогласующего(ДокументСсылка, Результат, Комментарий = "") Экспорт
	
	НачатьТранзакцию();
	Попытка
		ДокОбъект = ДокументСсылка.ПолучитьОбъект();
		ДокОбъект.Заблокировать();
		
		ТекЭтап = ДокОбъект.ТекущийЭтапСогласования;
		
		// Находим строку текущего этапа
		НайденаСтрока = Неопределено;
		Для Каждого Стр Из ДокОбъект.МаршрутСогласования Цикл
			Если Стр.НомерЭтапа = ТекЭтап Тогда
				НайденаСтрока = Стр;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если НайденаСтрока = Неопределено Тогда
			ВызватьИсключение "Не найден текущий этап согласования: " + ТекЭтап;
		КонецЕсли;
		
		// Записываем решение
		НайденаСтрока.Результат    = Результат;
		НайденаСтрока.Комментарий  = Комментарий;
		НайденаСтрока.ДатаРешения  = ТекущаяДатаСеанса();
		
		// Записываем в журнал согласования
		ЗаписатьВЖурналСогласования(ДокументСсылка, ТекЭтап,
			НайденаСтрока.Согласующий, Результат, Комментарий);
		
		// Определяем следующее действие
		Если Результат = Перечисления.РезультатыСогласования.Согласовано Тогда
			// Проверяем, есть ли следующий этап
			МаксЭтап = 0;
			Для Каждого Стр Из ДокОбъект.МаршрутСогласования Цикл
				Если Стр.НомерЭтапа > МаксЭтап Тогда
					МаксЭтап = Стр.НомерЭтапа;
				КонецЕсли;
			КонецЦикла;
			
			Если ТекЭтап >= МаксЭтап Тогда
				// Все этапы пройдены — документ согласован
				ДокОбъект.Статус = Перечисления.СтатусыДокументов.Согласован;
				ДокОбъект.ТекущийЭтапСогласования = 0;
				ЗаписатьАудит(ДокументСсылка, "Согласование", "Документ полностью согласован");
			Иначе
				// Переходим к следующему этапу
				ДокОбъект.ТекущийЭтапСогласования = ТекЭтап + 1;
				ЗаписатьАудит(ДокументСсылка, "Согласование",
					"Этап " + ТекЭтап + " согласован, переход к этапу " + (ТекЭтап + 1));
			КонецЕсли;
			
		ИначеЕсли Результат = Перечисления.РезультатыСогласования.ОтклоненоСЗамечаниями Тогда
			ДокОбъект.Статус = Перечисления.СтатусыДокументов.Отклонен;
			ДокОбъект.ТекущийЭтапСогласования = 0;
			ЗаписатьАудит(ДокументСсылка, "Отклонение",
				"Отклонено на этапе " + ТекЭтап + ". " + Комментарий);
			
		ИначеЕсли Результат = Перечисления.РезультатыСогласования.НаДоработку Тогда
			ДокОбъект.Статус = Перечисления.СтатусыДокументов.НаДоработке;
			ДокОбъект.ТекущийЭтапСогласования = 0;
			ЗаписатьАудит(ДокументСсылка, "НаДоработку",
				"Возвращено на доработку с этапа " + ТекЭтап + ". " + Комментарий);
		КонецЕсли;
		
		ДокОбъект.Записать();
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Повторно отправляет документ на согласование после доработки.
//
// Параметры:
//   ДокументСсылка - ДокументСсылка - ссылка на документ
//
Процедура ОтправитьПовторноНаСогласование(ДокументСсылка) Экспорт
	
	НачатьТранзакцию();
	Попытка
		ДокОбъект = ДокументСсылка.ПолучитьОбъект();
		ДокОбъект.Заблокировать();
		
		// Сбрасываем результаты в маршруте
		Для Каждого Стр Из ДокОбъект.МаршрутСогласования Цикл
			Стр.Результат    = Перечисления.РезультатыСогласования.ПустаяСсылка();
			Стр.Комментарий  = "";
			Стр.ДатаРешения  = Дата(1, 1, 1);
		КонецЦикла;
		
		ДокОбъект.ТекущийЭтапСогласования = 1;
		ДокОбъект.Статус = Перечисления.СтатусыДокументов.НаСогласовании;
		
		ДокОбъект.Записать();
		
		ЗаписатьАудит(ДокументСсылка, "ПовторноеСогласование",
			"Документ повторно отправлен на согласование после доработки");
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Возвращает таблицу задач на согласование для указанного сотрудника.
//
// Параметры:
//   Сотрудник - СправочникСсылка.Сотрудники - согласующий сотрудник
//
// Возвращаемое значение:
//   ТаблицаЗначений - список задач (Документ, Заголовок, ВидДокумента, НомерЭтапа, ...)
//
Функция ПолучитьЗадачиНаСогласование(Сотрудник) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	""ВходящийДокумент"" КАК ТипДокумента,
		|	Д.Ссылка КАК Документ,
		|	Д.Заголовок,
		|	Д.ВидДокумента,
		|	Д.Дата КАК ДатаДокумента,
		|	Д.ТекущийЭтапСогласования КАК НомерЭтапа,
		|	М.СрокДней
		|ИЗ
		|	Документ.ВходящийДокумент КАК Д
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВходящийДокумент.МаршрутСогласования КАК М
		|		ПО Д.Ссылка = М.Ссылка
		|		И М.НомерЭтапа = Д.ТекущийЭтапСогласования
		|ГДЕ
		|	Д.Статус = &СтатусНаСогласовании
		|	И М.Согласующий = &Сотрудник
		|	И М.Результат = &ПустойРезультат
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""ИсходящийДокумент"",
		|	Д.Ссылка,
		|	Д.Заголовок,
		|	Д.ВидДокумента,
		|	Д.Дата,
		|	Д.ТекущийЭтапСогласования,
		|	М.СрокДней
		|ИЗ
		|	Документ.ИсходящийДокумент КАК Д
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИсходящийДокумент.МаршрутСогласования КАК М
		|		ПО Д.Ссылка = М.Ссылка
		|		И М.НомерЭтапа = Д.ТекущийЭтапСогласования
		|ГДЕ
		|	Д.Статус = &СтатусНаСогласовании
		|	И М.Согласующий = &Сотрудник
		|	И М.Результат = &ПустойРезультат
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""ВнутреннийДокумент"",
		|	Д.Ссылка,
		|	Д.Заголовок,
		|	Д.ВидДокумента,
		|	Д.Дата,
		|	Д.ТекущийЭтапСогласования,
		|	М.СрокДней
		|ИЗ
		|	Документ.ВнутреннийДокумент КАК Д
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВнутреннийДокумент.МаршрутСогласования КАК М
		|		ПО Д.Ссылка = М.Ссылка
		|		И М.НомерЭтапа = Д.ТекущийЭтапСогласования
		|ГДЕ
		|	Д.Статус = &СтатусНаСогласовании
		|	И М.Согласующий = &Сотрудник
		|	И М.Результат = &ПустойРезультат
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаДокумента";
	
	Запрос.УстановитьПараметр("СтатусНаСогласовании",
		Перечисления.СтатусыДокументов.НаСогласовании);
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("ПустойРезультат",
		Перечисления.РезультатыСогласования.ПустаяСсылка());
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Записывает событие в журнал аудита.
//
// Параметры:
//   ДокументСсылка - ДокументСсылка - ссылка на документ
//   Действие       - Строка - тип действия (Создание, Изменение, Согласование и т.д.)
//   Подробности    - Строка - описание события
//
Процедура ЗаписатьАудит(ДокументСсылка, Действие, Подробности = "") Экспорт
	
	// Определяем порядковый номер
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	МАКСИМУМ(Ж.ПорядковыйНомер) КАК МаксНомер
		|ИЗ
		|	РегистрСведений.ЖурналАудита КАК Ж
		|ГДЕ
		|	Ж.Документ = &Документ";
	Запрос.УстановитьПараметр("Документ", ДокументСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	СледующийНомер = 1;
	Если Выборка.Следующий() И Выборка.МаксНомер <> NULL Тогда
		СледующийНомер = Выборка.МаксНомер + 1;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.ЖурналАудита.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Документ.Установить(ДокументСсылка);
	НаборЗаписей.Отбор.ПорядковыйНомер.Установить(СледующийНомер);
	НаборЗаписей.Прочитать();
	
	НоваяЗапись = НаборЗаписей.Добавить();
	НоваяЗапись.Период          = ТекущаяДатаСеанса();
	НоваяЗапись.Документ        = ДокументСсылка;
	НоваяЗапись.ПорядковыйНомер = СледующийНомер;
	НоваяЗапись.ДатаСобытия     = ТекущаяДатаСеанса();
	НоваяЗапись.Действие        = Действие;
	НоваяЗапись.Подробности     = Подробности;
	
	// Пользователь — по возможности определяем текущего
	Попытка
		НоваяЗапись.Пользователь = ОбщегоНазначения.ТекущийСотрудник();
	Исключение
		// Если не удалось определить — оставляем пустым
	КонецПопытки;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

// Сохраняет новую версию файла в регистр ВерсииФайлов.
//
// Параметры:
//   ДокументСсылка   - ДокументСсылка - ссылка на документ
//   ИмяФайла         - Строка - имя файла
//   ДанныеФайла      - ДвоичныеДанные - содержимое файла
//   Комментарий      - Строка - комментарий к версии
//
Процедура СохранитьВерсиюФайла(ДокументСсылка, ИмяФайла, ДанныеФайла, Комментарий = "") Экспорт
	
	// Определяем номер версии
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	МАКСИМУМ(В.НомерВерсии) КАК МаксВерсия
		|ИЗ
		|	РегистрСведений.ВерсииФайлов КАК В
		|ГДЕ
		|	В.Документ = &Документ";
	Запрос.УстановитьПараметр("Документ", ДокументСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	НоваяВерсия = 1;
	Если Выборка.Следующий() И Выборка.МаксВерсия <> NULL Тогда
		НоваяВерсия = Выборка.МаксВерсия + 1;
	КонецЕсли;
	
	Менеджер = РегистрыСведений.ВерсииФайлов.СоздатьМенеджерЗаписи();
	Менеджер.Период        = ТекущаяДатаСеанса();
	Менеджер.Документ      = ДокументСсылка;
	Менеджер.НомерВерсии   = НоваяВерсия;
	Менеджер.ИмяФайла      = ИмяФайла;
	Менеджер.ХранилищеФайла = Новый ХранилищеЗначения(ДанныеФайла);
	Менеджер.Размер        = ДанныеФайла.Размер();
	Менеджер.Комментарий   = Комментарий;
	
	Попытка
		Менеджер.Автор = ОбщегоНазначения.ТекущийСотрудник();
	Исключение
		// Если не удалось определить — оставляем пустым
	КонецПопытки;
	
	Менеджер.Записать();
	
	ЗаписатьАудит(ДокументСсылка, "ДобавлениеФайла",
		"Файл: " + ИмяФайла + ", версия: " + НоваяВерсия);
	
КонецПроцедуры

// Возвращает список версий файлов документа.
//
// Параметры:
//   ДокументСсылка - ДокументСсылка - ссылка на документ
//
// Возвращаемое значение:
//   ТаблицаЗначений
//
Функция ПолучитьВерсииФайлов(ДокументСсылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	В.Период,
		|	В.Документ,
		|	В.НомерВерсии,
		|	В.ИмяФайла,
		|	В.Размер,
		|	В.Автор,
		|	В.Комментарий
		|ИЗ
		|	РегистрСведений.ВерсииФайлов КАК В
		|ГДЕ
		|	В.Документ = &Документ
		|УПОРЯДОЧИТЬ ПО
		|	В.НомерВерсии УБЫВ";
	Запрос.УстановитьПараметр("Документ", ДокументСсылка);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Получает историю аудита документа.
//
// Параметры:
//   ДокументСсылка - ДокументСсылка - ссылка на документ
//
