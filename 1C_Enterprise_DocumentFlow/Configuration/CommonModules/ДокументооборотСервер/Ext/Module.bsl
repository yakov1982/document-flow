//
Функция ПолучитьИсториюАудита(ДокументСсылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Ж.Период,
		|	Ж.ДатаСобытия,
		|	Ж.Пользователь,
		|	Ж.Действие,
		|	Ж.Подробности
		|ИЗ
		|	РегистрСведений.ЖурналАудита КАК Ж
		|ГДЕ
		|	Ж.Документ = &Документ
		|УПОРЯДОЧИТЬ ПО
		|	Ж.ПорядковыйНомер";
	Запрос.УстановитьПараметр("Документ", ДокументСсылка);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

