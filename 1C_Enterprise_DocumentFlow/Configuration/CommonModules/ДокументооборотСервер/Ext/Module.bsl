#Область СлужебныеПроцедурыИФункции

Процедура ЗаписатьВЖурналСогласования(ДокументСсылка, НомерЭтапа, Согласующий, Результат, Комментарий)
	
	Менеджер = РегистрыСведений.ЖурналСогласования.СоздатьМенеджерЗаписи();
	Менеджер.Период      = ТекущаяДатаСеанса();
	Менеджер.Документ    = ДокументСсылка;
	Менеджер.НомерЭтапа  = НомерЭтапа;
	Менеджер.Согласующий  = Согласующий;
	Менеджер.Результат    = Результат;
	Менеджер.Комментарий  = Комментарий;
	Менеджер.ДатаРешения  = ТекущаяДатаСеанса();
	
	Менеджер.Записать();
	
КонецПроцедуры

#КонецОбласти
