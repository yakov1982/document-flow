#Область ПрограммныйИнтерфейс

// Возвращает ссылку на сотрудника, соответствующего текущему пользователю ИБ.
//
// Возвращаемое значение:
//   СправочникСсылка.Сотрудники - ссылка на сотрудника или ПустаяСсылка()
//
Функция ТекущийСотрудник() Экспорт
	
	ИмяПользователя = ИмяПользователя();
	
	Если НЕ ЗначениеЗаполнено(ИмяПользователя) Тогда
		Возврат Справочники.Сотрудники.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	С.Ссылка
		|ИЗ
		|	Справочник.Сотрудники КАК С
		|ГДЕ
		|	С.Наименование = &ИмяПользователя
		|	И НЕ С.ПометкаУдаления";
	Запрос.УстановитьПараметр("ИмяПользователя", ИмяПользователя);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.Сотрудники.ПустаяСсылка();
	
КонецФункции

// Проверяет, заполнено ли значение (не пустое, не Неопределено, не дата по умолчанию).
//
// Параметры:
//   Значение - Произвольный
//
// Возвращаемое значение:
//   Булево
//
Функция ЗначениеЗаполненоДополнительно(Значение) Экспорт
	
	Если Значение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат СокрЛП(Значение) <> "";
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение <> 0;
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Значение <> Дата(1, 1, 1);
	КонецЕсли;
	
	Возврат ЗначениеЗаполнено(Значение);
	
КонецФункции

// Форматирует размер файла в человекочитаемый вид.
//
// Параметры:
//   РазмерБайт - Число
//
// Возвращаемое значение:
//   Строка - например "1.5 МБ"
//
Функция ФорматРазмераФайла(РазмерБайт) Экспорт
	
	Если РазмерБайт < 1024 Тогда
		Возврат Формат(РазмерБайт, "ЧГ=0") + " Б";
	ИначеЕсли РазмерБайт < 1024 * 1024 Тогда
		Возврат Формат(РазмерБайт / 1024, "ЧДЦ=1; ЧГ=0") + " КБ";
	ИначеЕсли РазмерБайт < 1024 * 1024 * 1024 Тогда
		Возврат Формат(РазмерБайт / 1024 / 1024, "ЧДЦ=2; ЧГ=0") + " МБ";
	Иначе
		Возврат Формат(РазмерБайт / 1024 / 1024 / 1024, "ЧДЦ=2; ЧГ=0") + " ГБ";
	КонецЕсли;
	
КонецФункции

// Записывает в журнал регистрации сообщение.
//
// Параметры:
//   Уровень     - Строка - "Информация", "Предупреждение", "Ошибка"
//   Сообщение   - Строка
//   Данные      - Произвольный - ссылка на объект (необязательно)
//
Процедура ЗаписатьВЖурналРегистрации(Уровень, Сообщение, Данные = Неопределено) Экспорт
	
	УровеньСобытия = УровеньЖурналаРегистрации.Информация;
	
	Если Уровень = "Предупреждение" Тогда
		УровеньСобытия = УровеньЖурналаРегистрации.Предупреждение;
	ИначеЕсли Уровень = "Ошибка" Тогда
		УровеньСобытия = УровеньЖурналаРегистрации.Ошибка;
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации("Документооборот",
		УровеньСобытия,
		?(Данные <> Неопределено, Данные.Метаданные(), Неопределено),
		Данные,
		Сообщение);
	
КонецПроцедуры

#КонецОбласти
