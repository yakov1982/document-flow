////////////////////////////////////////////////////////////////////////////////
// Форма обработки «ПанельЗадач»
// Рабочее место согласующего: отображение задач на согласование
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Определяем текущего сотрудника
	ТекущийСотрудник = ОбщегоНазначения.ТекущийСотрудник();
	
	Если НЕ ЗначениеЗаполнено(ТекущийСотрудник) Тогда
		Элементы.ДекорацияПредупреждение.Видимость = Истина;
		Элементы.ДекорацияПредупреждение.Заголовок =
			"Не удалось определить текущего сотрудника. Убедитесь, что ваше имя пользователя совпадает с наименованием в справочнике ""Сотрудники"".";
	Иначе
		Элементы.ДекорацияПредупреждение.Видимость = Ложь;
	КонецЕсли;
	
	ОбновитьСписокЗадач();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)
	
	ОбновитьСписокЗадач();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДокумент(Команда)
	
	ТекущиеДанные = Элементы.ТаблицаЗадач.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьЗначение(, ТекущиеДанные.Документ);
	
КонецПроцедуры

&НаКлиенте
Процедура Согласовать(Команда)
	
	ТекущиеДанные = Элементы.ТаблицаЗадач.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Открываем форму согласования
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Документ", ТекущиеДанные.Документ);
	
	ОткрытьФорму("ОбщаяФорма.ФормаСогласования", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ДокументСогласован" ИЛИ ИмяСобытия = "ДокументОтклонен" Тогда
		ОбновитьСписокЗадач();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьСписокЗадач()
	
	ТекущийСотрудник = ОбщегоНазначения.ТекущийСотрудник();
	
	Если НЕ ЗначениеЗаполнено(ТекущийСотрудник) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаЗадач = ДокументооборотСервер.ПолучитьЗадачиНаСогласование(ТекущийСотрудник);
	
	// Загружаем в реквизит формы
	ТаблицаЗадачФорма.Очистить();
	
	Для Каждого Строка Из ТаблицаЗадач Цикл
		НоваяСтрока = ТаблицаЗадачФорма.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;
	
	Элементы.ДекорацияКоличество.Заголовок =
		"Задач на согласование: " + ТаблицаЗадач.Количество();
	
КонецПроцедуры

#КонецОбласти
