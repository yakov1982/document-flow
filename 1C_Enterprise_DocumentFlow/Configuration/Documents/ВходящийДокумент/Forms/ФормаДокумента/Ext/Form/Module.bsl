////////////////////////////////////////////////////////////////////////////////
// Форма документа «ВходящийДокумент»
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбновитьДоступностьКоманд(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ОбновитьДоступностьКоманд(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииВидаДокумента(Элемент)
	
	// Автоподстановка шаблона маршрута из вида документа
	Если ЗначениеЗаполнено(Объект.ВидДокумента) Тогда
		ЗаполнитьМаршрутИзВида(Объект.ВидДокумента);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Зарегистрировать(Команда)
	
	Если НЕ ДокументооборотКлиентСервер.МожноЗарегистрировать(Объект.Статус) Тогда
		ПоказатьПредупреждение(, "Регистрация в текущем статусе невозможна.");
		Возврат;
	КонецЕсли;
	
	Если Модифицированность Тогда
		Записать();
	КонецЕсли;
	
	ЗарегистрироватьНаСервере();
	Прочитать();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьНаСогласование(Команда)
	
	Если НЕ ДокументооборотКлиентСервер.МожноОтправитьНаСогласование(Объект.Статус) Тогда
		ПоказатьПредупреждение(, "Отправка на согласование в текущем статусе невозможна.");
		Возврат;
	КонецЕсли;
	
	Если Модифицированность Тогда
		Записать();
	КонецЕсли;
	
	ОтправитьНаСогласованиеНаСервере();
	Прочитать();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИсторию(Команда)
	
	ИсторияАудита = ПолучитьИсториюАудитаНаСервере(Объект.Ссылка);
	
	Если ИсторияАудита.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "История аудита пуста.");
		Возврат;
	КонецЕсли;
	
	// Отображаем простым списком
	ТекстИстории = "";
	Для Каждого Запись Из ИсторияАудита Цикл
		ТекстИстории = ТекстИстории
			+ Формат(Запись.ДатаСобытия, "ДЛФ=ДВ") + " | "
			+ Запись.Действие + " | "
			+ Строка(Запись.Пользователь) + " | "
			+ Запись.Подробности + Символы.ПС;
	КонецЦикла;
	
	ПоказатьПредупреждение(, ТекстИстории);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗарегистрироватьНаСервере()
	
	ДокументооборотСервер.ЗарегистрироватьДокумент(Объект.Ссылка);
	
КонецПроцедуры

&НаСервере
Процедура ОтправитьНаСогласованиеНаСервере()
	
	ДокументооборотСервер.ОтправитьНаСогласование(Объект.Ссылка);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьИсториюАудитаНаСервере(ДокументСсылка)
	
	Возврат ДокументооборотСервер.ПолучитьИсториюАудита(ДокументСсылка);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьДоступностьКоманд(Форма)
	
	Статус = Форма.Объект.Статус;
	
	МожноРегистрировать  = ДокументооборотКлиентСервер.МожноЗарегистрировать(Статус);
	МожноСогласовать     = ДокументооборотКлиентСервер.МожноОтправитьНаСогласование(Статус);
	
	Форма.Элементы.ФормаЗарегистрировать.Доступность       = МожноРегистрировать;
	Форма.Элементы.ФормаОтправитьНаСогласование.Доступность = МожноСогласовать;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМаршрутИзВида(ВидДокумента)
	
	Если ЗначениеЗаполнено(ВидДокумента.ШаблонМаршрута) Тогда
		Объект.ШаблонМаршрута = ВидДокумента.ШаблонМаршрута;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
