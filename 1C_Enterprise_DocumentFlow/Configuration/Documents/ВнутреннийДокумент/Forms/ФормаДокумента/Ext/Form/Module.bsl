////////////////////////////////////////////////////////////////////////////////
// Форма документа «ВнутреннийДокумент»
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбновитьДоступностьКоманд(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ОбновитьДоступностьКоманд(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Зарегистрировать(Команда)
	
	Если НЕ ДокументооборотКлиентСервер.МожноЗарегистрировать(Объект.Статус) Тогда
		ПоказатьПредупреждение(, "Регистрация в текущем статусе невозможна.");
		Возврат;
	КонецЕсли;
	
	Если Модифицированность Тогда
		Записать();
	КонецЕсли;
	
	ЗарегистрироватьНаСервере();
	Прочитать();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьНаСогласование(Команда)
	
	Если НЕ ДокументооборотКлиентСервер.МожноОтправитьНаСогласование(Объект.Статус) Тогда
		ПоказатьПредупреждение(, "Отправка на согласование в текущем статусе невозможна.");
		Возврат;
	КонецЕсли;
	
	Если Модифицированность Тогда
		Записать();
	КонецЕсли;
	
	ОтправитьНаСогласованиеНаСервере();
	Прочитать();
	
КонецПроцедуры

&НаКлиенте
Процедура ПовторноНаСогласование(Команда)
	
	Если Объект.Статус <> ПредопределенноеЗначение("Перечисление.СтатусыДокументов.НаДоработке") Тогда
		ПоказатьПредупреждение(, "Повторная отправка возможна только из статуса «На доработке».");
		Возврат;
	КонецЕсли;
	
	ПовторноНаСогласованиеНаСервере();
	Прочитать();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИсторию(Команда)
	
	ИсторияАудита = ПолучитьИсториюАудитаНаСервере(Объект.Ссылка);
	
	Если ИсторияАудита.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "История аудита пуста.");
		Возврат;
	КонецЕсли;
	
	ТекстИстории = "";
	Для Каждого Запись Из ИсторияАудита Цикл
		ТекстИстории = ТекстИстории
			+ Формат(Запись.ДатаСобытия, "ДЛФ=ДВ") + " | "
			+ Запись.Действие + " | "
			+ Строка(Запись.Пользователь) + " | "
			+ Запись.Подробности + Символы.ПС;
	КонецЦикла;
	
	ПоказатьПредупреждение(, ТекстИстории);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВерсииФайлов(Команда)
	
	Версии = ПолучитьВерсииФайловНаСервере(Объект.Ссылка);
	
	Если Версии.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Версии файлов отсутствуют.");
		Возврат;
	КонецЕсли;
	
	ТекстВерсий = "";
	Для Каждого Запись Из Версии Цикл
		ТекстВерсий = ТекстВерсий
			+ "v" + Запись.НомерВерсии + " | "
			+ Запись.ИмяФайла + " | "
			+ ОбщегоНазначения.ФорматРазмераФайла(Запись.Размер) + " | "
			+ Строка(Запись.Автор) + " | "
			+ Формат(Запись.Период, "ДЛФ=ДВ")
			+ Символы.ПС;
	КонецЦикла;
	
	ПоказатьПредупреждение(, ТекстВерсий);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗарегистрироватьНаСервере()
	
	ДокументооборотСервер.ЗарегистрироватьДокумент(Объект.Ссылка);
	
КонецПроцедуры

&НаСервере
Процедура ОтправитьНаСогласованиеНаСервере()
	
	ДокументооборотСервер.ОтправитьНаСогласование(Объект.Ссылка);
	
КонецПроцедуры

&НаСервере
Процедура ПовторноНаСогласованиеНаСервере()
	
	ДокументооборотСервер.ОтправитьПовторноНаСогласование(Объект.Ссылка);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьИсториюАудитаНаСервере(ДокументСсылка)
	
	Возврат ДокументооборотСервер.ПолучитьИсториюАудита(ДокументСсылка);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьВерсииФайловНаСервере(ДокументСсылка)
	
	Возврат ДокументооборотСервер.ПолучитьВерсииФайлов(ДокументСсылка);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьДоступностьКоманд(Форма)
	
	Статус = Форма.Объект.Статус;
	
	МожноРегистрировать  = ДокументооборотКлиентСервер.МожноЗарегистрировать(Статус);
	МожноСогласовать     = ДокументооборотКлиентСервер.МожноОтправитьНаСогласование(Статус);
	НаДоработке          = Статус = ПредопределенноеЗначение("Перечисление.СтатусыДокументов.НаДоработке");
	
	Форма.Элементы.ФормаЗарегистрировать.Доступность           = МожноРегистрировать;
	Форма.Элементы.ФормаОтправитьНаСогласование.Доступность     = МожноСогласовать;
	Форма.Элементы.ФормаПовторноНаСогласование.Доступность      = НаДоработке;
	
КонецПроцедуры

#КонецОбласти
