////////////////////////////////////////////////////////////////////////////////
// Модуль объекта документа «ИсходящийДокумент»
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытий

Процедура ПриКопировании(ОбъектКопирования)
	
	РегистрационныйНомер       = "";
	ДатаРегистрации             = Дата(1, 1, 1);
	Статус                      = Перечисления.СтатусыДокументов.Черновик;
	ТекущийЭтапСогласования     = 0;
	ДатаОтправки                = Дата(1, 1, 1);
	МаршрутСогласования.Очистить();
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если НЕ ЗначениеЗаполнено(Статус) Тогда
		Статус = Перечисления.СтатусыДокументов.Черновик;
	КонецЕсли;
	
	// Если создаётся как ответ на входящий
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ВходящийДокумент") Тогда
		СвязанныйВходящий = ДанныеЗаполнения;
		Получатель         = ДанныеЗаполнения.Отправитель;
		ВидДокумента       = ДанныеЗаполнения.ВидДокумента;
		Заголовок          = "Re: " + ДанныеЗаполнения.Заголовок;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Ошибки = ДокументооборотКлиентСервер.ПроверитьЗаполнениеДокумента(ВидДокумента, Заголовок);
	
	Для Каждого Ошибка Из Ошибки Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Ошибка;
		Сообщение.Сообщить();
	КонецЦикла;
	
	Если Ошибки.Количество() > 0 Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоНовый() Тогда
		ДокументооборотСервер.ЗаписатьАудит(Ссылка, "Создание",
			"Исходящий документ создан: " + Заголовок);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
