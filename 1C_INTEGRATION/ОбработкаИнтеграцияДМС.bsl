// Внешняя обработка "Интеграция с системой документооборота"
// Версия: 1.0.0
// Платформа: 1С:Предприятие 8.3

#Область ОписаниеПеременных

Перем АдресСервера;      // Строка - адрес сервера API (например, http://localhost:8080)
Перем Логин;             // Строка - логин пользователя
Перем Пароль;            // Строка - пароль пользователя
Перем Таймаут;           // Число - таймаут соединения в секундах

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Конструктор - инициализация параметров по умолчанию
//
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    
    АдресСервера = "http://localhost:8080";
    Логин = "";
    Пароль = "";
    Таймаут = 30;
    
КонецПроцедуры

// Устанавливает параметры подключения к API
//
// Параметры:
//  НовыйАдресСервера - Строка - адрес сервера API
//  НовыйЛогин - Строка - логин пользователя
//  НовыйПароль - Строка - пароль пользователя
//
Процедура УстановитьПараметрыПодключения(НовыйАдресСервера, НовыйЛогин, НовыйПароль) Экспорт
    
    АдресСервера = НовыйАдресСервера;
    Логин = НовыйЛогин;
    Пароль = НовыйПароль;
    
КонецПроцедуры

// Отправляет документ 1С в систему документооборота
//
// Параметры:
//  ДокументСсылка - ДокументСсылка - ссылка на документ 1С
//  Заголовок - Строка - заголовок документа
//  ТипДокумента - Строка - тип документа (invoice, contract, act и т.д.)
//  МассивСогласующих - Массив - массив логинов согласующих
//  ПрикрепитьПечатнуюФорму - Булево - прикрепить ли печатную форму PDF
//
// Возвращаемое значение:
//  Структура - результат отправки:
//    * Успех - Булево
//    * ИдентификаторДокумента - Число - ID созданного документа в СЭД
//    * ТекстОшибки - Строка
//
Функция ОтправитьДокументВСЭД(
    ДокументСсылка,
    Заголовок,
    ТипДокумента,
    МассивСогласующих,
    ПрикрепитьПечатнуюФорму = Истина) Экспорт
    
    Результат = Новый Структура;
    Результат.Вставить("Успех", Ложь);
    Результат.Вставить("ИдентификаторДокумента", 0);
    Результат.Вставить("ТекстОшибки", "");
    
    Попытка
        
        // Проверка параметров
        Если Не ЗначениеЗаполнено(АдресСервера) Тогда
            Результат.ТекстОшибки = "Не указан адрес сервера API";
            Возврат Результат;
        КонецЕсли;
        
        Если Не ЗначениеЗаполнено(Логин) Или Не ЗначениеЗаполнено(Пароль) Тогда
            Результат.ТекстОшибки = "Не указаны учетные данные";
            Возврат Результат;
        КонецЕсли;
        
        // Формирование данных документа
        ДанныеДокумента = Новый Структура;
        ДанныеДокумента.Вставить("title", Заголовок);
        ДанныеДокумента.Вставить("document_type", ТипДокумента);
        ДанныеДокумента.Вставить("metadata", Новый Структура);
        
        // Добавление метаданных документа 1С
        Метаданные = Новый Структура;
        Метаданные.Вставить("source_system", "1C:Enterprise 8.3");
        Метаданные.Вставить("document_guid", Строка(ДокументСсылка.УникальныйИдентификатор()));
        Метаданные.Вставить("document_type_1c", ДокументСсылка.Метаданные().Имя);
        
        Если ДокументСсылка.Метаданные().Реквизиты.Найти("Номер") <> Неопределено Тогда
            Метаданные.Вставить("document_number", ДокументСсылка.Номер);
        КонецЕсли;
        
        Если ДокументСсылка.Метаданные().Реквизиты.Найти("Дата") <> Неопределено Тогда
            Метаданные.Вставить("document_date", Формат(ДокументСсылка.Дата, "ДФ=yyyy-MM-dd"));
        КонецЕсли;
        
        ДанныеДокумента.Метаданные = Метаданные;
        
        // Параметры подключения
        Параметры = ПолучитьПараметрыПодключения();
        
        // Создание документа в СЭД
        РезультатСоздания = МодульИнтеграцииAPI.СоздатьДокумент(Параметры, ДанныеДокумента);
        
        Если Не РезультатСоздания.Успех Тогда
            Результат.ТекстОшибки = РезультатСоздания.ТекстОшибки;
            Возврат Результат;
        КонецЕсли;
        
        ИдентификаторДокумента = РезультатСоздания.Данные.id;
        Результат.ИдентификаторДокумента = ИдентификаторДокумента;
        
        // Прикрепление файла (если требуется)
        Если ПрикрепитьПечатнуюФорму Тогда
            
            // Получение печатной формы
            ТабличныйДокумент = ПолучитьПечатнуюФормуДокумента(ДокументСсылка);
            
            Если ТабличныйДокумент <> Неопределено Тогда
                
                // Сохранение во временный файл
                ИмяВременногоФайла = ПолучитьИмяВременногоФайла("pdf");
                ТабличныйДокумент.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.PDF);
                
                // TODO: Загрузка файла через multipart/form-data
                // В текущей версии файлы загружаются через отдельный endpoint
                // РезультатЗагрузки = ЗагрузитьФайлВДокумент(Параметры, ИдентификаторДокумента, ИмяВременногоФайла);
                
                // Удаление временного файла
                Попытка
                    УдалитьФайлы(ИмяВременногоФайла);
                Исключение
                    // Игнорируем ошибку удаления временного файла
                КонецПопытки;
                
            КонецЕсли;
            
        КонецЕсли;
        
        // Создание маршрута согласования
        Если МассивСогласующих.Количество() > 0 Тогда
            
            Для Каждого ЛогинСогласующего Из МассивСогласующих Цикл
                
                ДанныеЗадачи = Новый Структура;
                ДанныеЗадачи.Вставить("document_id", ИдентификаторДокумента);
                ДанныеЗадачи.Вставить("assignee_username", ЛогинСогласующего);
                ДанныеЗадачи.Вставить("action", "approve");
                
                РезультатЗадачи = МодульИнтеграцииAPI.СоздатьЗадачуСогласования(
                    Параметры,
                    ИдентификаторДокумента,
                    ДанныеЗадачи
                );
                
                Если Не РезультатЗадачи.Успех Тогда
                    // Логируем ошибку, но продолжаем
                    ЗаписьЖурналаРегистрации(
                        "ИнтеграцияДМС.СозданиеЗадачи",
                        УровеньЖурналаРегистрации.Предупреждение,
                        ,
                        ,
                        "Не удалось создать задачу для " + ЛогинСогласующего + ": " + РезультатЗадачи.ТекстОшибки
                    );
                КонецЕсли;
                
            КонецЦикла;
            
        КонецЕсли;
        
        Результат.Успех = Истина;
        
        // Запись в журнал регистрации
        ЗаписьЖурналаРегистрации(
            "ИнтеграцияДМС.ОтправкаДокумента",
            УровеньЖурналаРегистрации.Информация,
            ,
            ДокументСсылка,
            СтрШаблон("Документ %1 отправлен в СЭД. ID: %2", Заголовок, ИдентификаторДокумента)
        );
        
    Исключение
        
        Результат.ТекстОшибки = ОписаниеОшибки();
        
        ЗаписьЖурналаРегистрации(
            "ИнтеграцияДМС.ОтправкаДокумента",
            УровеньЖурналаРегистрации.Ошибка,
            ,
            ДокументСсылка,
            Результат.ТекстОшибки
        );
        
    КонецПопытки;
    
    Возврат Результат;
    
КонецФункции

// Получает статус документа из СЭД
//
// Параметры:
//  ИдентификаторДокумента - Число - ID документа в СЭД
//
// Возвращаемое значение:
//  Строка - статус документа (draft, pending, approved, rejected)
//
Функция ПолучитьСтатусДокумента(ИдентификаторДокумента) Экспорт
    
    Параметры = ПолучитьПараметрыПодключения();
    
    РезультатЗапроса = МодульИнтеграцииAPI.ПолучитьДокумент(Параметры, ИдентификаторДокумента);
    
    Если РезультатЗапроса.Успех И РезультатЗапроса.Данные.Свойство("status") Тогда
        Возврат РезультатЗапроса.Данные.status;
    КонецЕсли;
    
    Возврат "";
    
КонецФункции

// Получает список документов из СЭД
//
// Параметры:
//  Статус - Строка - фильтр по статусу (необязательно)
//
// Возвращаемое значение:
//  Массив - массив структур с данными документов
//
Функция ПолучитьСписокДокументов(Статус = "") Экспорт
    
    Параметры = ПолучитьПараметрыПодключения();
    
    РезультатЗапроса = МодульИнтеграцииAPI.ПолучитьСписокДокументов(Параметры, Статус);
    
    Если РезультатЗапроса.Успех Тогда
        Возврат РезультатЗапроса.Данные;
    КонецЕсли;
    
    Возврат Новый Массив;
    
КонецФункции

// Получает список задач текущего пользователя
//
// Возвращаемое значение:
//  Массив - массив структур с задачами на согласование
//
Функция ПолучитьМоиЗадачи() Экспорт
    
    Параметры = ПолучитьПараметрыПодключения();
    
    РезультатЗапроса = МодульИнтеграцииAPI.ПолучитьМоиЗадачи(Параметры);
    
    Если РезультатЗапроса.Успех Тогда
        Возврат РезультатЗапроса.Данные;
    КонецЕсли;
    
    Возврат Новый Массив;
    
КонецФункции

// Согласовывает документ
//
// Параметры:
//  ИдентификаторЗадачи - Число - ID задачи
//  Комментарий - Строка - комментарий согласующего
//
// Возвращаемое значение:
//  Структура - результат согласования
//
Функция СогласоватьДокумент(ИдентификаторЗадачи, Комментарий = "") Экспорт
    
    Параметры = ПолучитьПараметрыПодключения();
    
    Результат = МодульИнтеграцииAPI.СогласоватьДокумент(Параметры, ИдентификаторЗадачи, Комментарий);
    
    Если Результат.Успех Тогда
        ЗаписьЖурналаРегистрации(
            "ИнтеграцияДМС.Согласование",
            УровеньЖурналаРегистрации.Информация,
            ,
            ,
            СтрШаблон("Задача %1 согласована", ИдентификаторЗадачи)
        );
    КонецЕсли;
    
    Возврат Результат;
    
КонецФункции

// Отклоняет документ
//
// Параметры:
//  ИдентификаторЗадачи - Число - ID задачи
//  Комментарий - Строка - комментарий об отклонении
//
// Возвращаемое значение:
//  Структура - результат отклонения
//
Функция ОтклонитьДокумент(ИдентификаторЗадачи, Комментарий) Экспорт
    
    Параметры = ПолучитьПараметрыПодключения();
    
    Результат = МодульИнтеграцииAPI.ОтклонитьДокумент(Параметры, ИдентификаторЗадачи, Комментарий);
    
    Если Результат.Успех Тогда
        ЗаписьЖурналаРегистрации(
            "ИнтеграцияДМС.Отклонение",
            УровеньЖурналаРегистрации.Информация,
            ,
            ,
            СтрШаблон("Задача %1 отклонена: %2", ИдентификаторЗадачи, Комментарий)
        );
    КонецЕсли;
    
    Возврат Результат;
    
КонецФункции

// Тестирует подключение к API
//
// Возвращаемое значение:
//  Структура - результат тестирования
//
Функция ТестироватьПодключение() Экспорт
    
    Результат = Новый Структура;
    Результат.Вставить("Успех", Ложь);
    Результат.Вставить("Сообщение", "");
    
    Попытка
        
        Параметры = ПолучитьПараметрыПодключения();
        
        // Попытка получить токен
        Токен = МодульИнтеграцииAPI.ПолучитьТокенАвторизации(Параметры);
        
        Если ЗначениеЗаполнено(Токен) Тогда
            Результат.Успех = Истина;
            Результат.Сообщение = "Подключение установлено успешно";
        Иначе
            Результат.Сообщение = "Не удалось авторизоваться. Проверьте логин и пароль";
        КонецЕсли;
        
    Исключение
        
        Результат.Сообщение = ОписаниеОшибки();
        
    КонецПопытки;
    
    Возврат Результат;
    
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает структуру с параметрами подключения
//
// Возвращаемое значение:
//  Структура - параметры подключения
//
Функция ПолучитьПараметрыПодключения()
    
    Параметры = Новый Структура;
    Параметры.Вставить("АдресСервера", АдресСервера);
    Параметры.Вставить("Логин", Логин);
    Параметры.Вставить("Пароль", Пароль);
    
    Возврат Параметры;
    
КонецФункции

// Получает печатную форму документа
//
// Параметры:
//  ДокументСсылка - ДокументСсылка - ссылка на документ
//
// Возвращаемое значение:
//  ТабличныйДокумент - печатная форма или Неопределено
//
Функция ПолучитьПечатнуюФормуДокумента(ДокументСсылка)
    
    Попытка
        
        // Попытка получить печатную форму
        // Это упрощенный вариант, в реальной системе нужно использовать
        // УправлениеПечатью.СформироватьДокументыДляБыстройПечати()
        
        МассивОбъектов = Новый Массив;
        МассивОбъектов.Добавить(ДокументСсылка);
        
        // Получение менеджера печати
        МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(ДокументСсылка);
        
        // Формирование печатной формы (примерный код)
        // В реальной конфигурации используйте существующие печатные формы
        ТабличныйДокумент = Новый ТабличныйДокумент;
        
        // Заголовок
        ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
        Область = ТабличныйДокумент.Область();
        Область.Текст = "Документ: " + Строка(ДокументСсылка);
        
        Возврат ТабличныйДокумент;
        
    Исключение
        
        Возврат Неопределено;
        
    КонецПопытки;
    
КонецФункции

#КонецОбласти
