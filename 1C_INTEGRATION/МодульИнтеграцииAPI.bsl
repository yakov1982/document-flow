// Выполняет HTTP-запрос к API документооборота
//
// Параметры:
//  Метод - Строка - HTTP метод (GET, POST, PUT, DELETE)
//  Путь - Строка - путь к ресурсу API (например, "/api/documents")
//  Параметры - Структура - параметры подключения (АдресСервера, Логин, Пароль)
//  ТелоЗапроса - Строка - тело запроса в формате JSON (необязательно)
//
// Возвращаемое значение:
//  Структура - результат запроса с полями:
//    * Успех - Булево
//    * Данные - Произвольный - распарсенный JSON ответа
//    * КодОтвета - Число
//    * ТекстОшибки - Строка
//
Функция ВыполнитьЗапросAPI(Метод, Путь, Параметры, ТелоЗапроса = Неопределено) Экспорт
    
    Результат = Новый Структура;
    Результат.Вставить("Успех", Ложь);
    Результат.Вставить("Данные", Неопределено);
    Результат.Вставить("КодОтвета", 0);
    Результат.Вставить("ТекстОшибки", "");
    
    Попытка
        
        // Создание HTTP-соединения
        АдресСервера = Параметры.АдресСервера;
        Если ПраваяЧасть(АдресСервера, 1) = "/" Тогда
            АдресСервера = Лев(АдресСервера, СтрДлина(АдресСервера) - 1);
        КонецЕсли;
        
        // Парсинг URL
        СтруктураURL = РазобратьURL(АдресСервера);
        
        // Создание соединения
        ЗащищенноеСоединение = Неопределено;
        Если СтруктураURL.Схема = "https" Тогда
            ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Неопределено);
        КонецЕсли;
        
        Соединение = Новый HTTPСоединение(
            СтруктураURL.Хост,
            СтруктураURL.Порт,
            Параметры.Логин,
            Параметры.Пароль,
            Неопределено,
            30,
            ЗащищенноеСоединение
        );
        
        // Формирование запроса
        Запрос = Новый HTTPЗапрос(Путь);
        Запрос.Заголовки.Вставить("Content-Type", "application/json");
        Запрос.Заголовки.Вставить("Accept", "application/json");
        
        // Авторизация через JWT
        Если Параметры.Свойство("Токен") И ЗначениеЗаполнено(Параметры.Токен) Тогда
            Запрос.Заголовки.Вставить("Authorization", "Bearer " + Параметры.Токен);
        КонецЕсли;
        
        // Установка тела запроса
        Если ТелоЗапроса <> Неопределено Тогда
            Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
        КонецЕсли;
        
        // Выполнение запроса
        Ответ = Неопределено;
        
        Если Метод = "GET" Тогда
            Ответ = Соединение.Получить(Запрос);
        ИначеЕсли Метод = "POST" Тогда
            Ответ = Соединение.ОтправитьДляОбработки(Запрос);
        ИначеЕсли Метод = "PUT" Тогда
            Ответ = Соединение.ОтправитьДляОбработки(Запрос);
        ИначеЕсли Метод = "DELETE" Тогда
            Ответ = Соединение.Удалить(Запрос);
        Иначе
            ВызватьИсключение "Неподдерживаемый HTTP метод: " + Метод;
        КонецЕсли;
        
        Результат.КодОтвета = Ответ.КодСостояния;
        
        // Обработка ответа
        Если Ответ.КодСостояния >= 200 И Ответ.КодСостояния < 300 Тогда
            
            ТелоОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
            
            Если ЗначениеЗаполнено(ТелоОтвета) Тогда
                ЧтениеJSON = Новый ЧтениеJSON;
                ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
                Результат.Данные = ПрочитатьJSON(ЧтениеJSON);
                ЧтениеJSON.Закрыть();
            КонецЕсли;
            
            Результат.Успех = Истина;
            
        Иначе
            
            ТелоОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
            Результат.ТекстОшибки = СтрШаблон("HTTP %1: %2", Ответ.КодСостояния, ТелоОтвета);
            
        КонецЕсли;
        
    Исключение
        
        Результат.ТекстОшибки = ОписаниеОшибки();
        
    КонецПопытки;
    
    Возврат Результат;
    
КонецФункции

// Получает JWT токен для авторизации
//
// Параметры:
//  Параметры - Структура - параметры подключения
//
// Возвращаемое значение:
//  Строка - JWT токен или пустая строка в случае ошибки
//
Функция ПолучитьТокенАвторизации(Параметры) Экспорт
    
    // Формирование тела запроса
    ДанныеАвторизации = Новый Структура;
    ДанныеАвторизации.Вставить("username", Параметры.Логин);
    ДанныеАвторизации.Вставить("password", Параметры.Пароль);
    
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, ДанныеАвторизации);
    ТелоЗапроса = ЗаписьJSON.Закрыть();
    
    // Отправка запроса (без токена)
    ПараметрыБезТокена = Новый Структура;
    ПараметрыБезТокена.Вставить("АдресСервера", Параметры.АдресСервера);
    ПараметрыБезТокена.Вставить("Логин", "");
    ПараметрыБезТокена.Вставить("Пароль", "");
    
    // В FastAPI используется form-data для токена
    Путь = "/api/auth/token";
    ТелоФормы = "username=" + КодироватьСтроку(Параметры.Логин, СпособКодированияСтроки.КодировкаURL) 
              + "&password=" + КодироватьСтроку(Параметры.Пароль, СпособКодированияСтроки.КодировкаURL);
    
    Попытка
        
        СтруктураURL = РазобратьURL(Параметры.АдресСервера);
        
        ЗащищенноеСоединение = Неопределено;
        Если СтруктураURL.Схема = "https" Тогда
            ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Неопределено);
        КонецЕсли;
        
        Соединение = Новый HTTPСоединение(
            СтруктураURL.Хост,
            СтруктураURL.Порт,
            "",
            "",
            Неопределено,
            30,
            ЗащищенноеСоединение
        );
        
        Запрос = Новый HTTPЗапрос(Путь);
        Запрос.Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
        Запрос.УстановитьТелоИзСтроки(ТелоФормы, КодировкаТекста.UTF8);
        
        Ответ = Соединение.ОтправитьДляОбработки(Запрос);
        
        Если Ответ.КодСостояния = 200 Тогда
            
            ТелоОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
            
            ЧтениеJSON = Новый ЧтениеJSON;
            ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
            Данные = ПрочитатьJSON(ЧтениеJSON);
            ЧтениеJSON.Закрыть();
            
            Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("access_token") Тогда
                Возврат Данные.access_token;
            КонецЕсли;
            
        КонецЕсли;
        
    Исключение
        // Ошибка авторизации
    КонецПопытки;
    
    Возврат "";
    
КонецФункции

// Разбирает URL на составные части
//
// Параметры:
//  URL - Строка - полный URL адрес
//
// Возвращаемое значение:
//  Структура - части URL
//
Функция РазобратьURL(URL) Экспорт
    
    Результат = Новый Структура;
    Результат.Вставить("Схема", "http");
    Результат.Вставить("Хост", "localhost");
    Результат.Вставить("Порт", 80);
    Результат.Вставить("Путь", "");
    
    СтрокаURL = URL;
    
    // Схема
    Позиция = Найти(СтрокаURL, "://");
    Если Позиция > 0 Тогда
        Результат.Схема = Лев(СтрокаURL, Позиция - 1);
        СтрокаURL = Сред(СтрокаURL, Позиция + 3);
    КонецЕсли;
    
    // Хост и порт
    Позиция = Найти(СтрокаURL, "/");
    ХостИПорт = "";
    Если Позиция > 0 Тогда
        ХостИПорт = Лев(СтрокаURL, Позиция - 1);
        Результат.Путь = Сред(СтрокаURL, Позиция);
    Иначе
        ХостИПорт = СтрокаURL;
    КонецЕсли;
    
    // Разделение хоста и порта
    Позиция = Найти(ХостИПорт, ":");
    Если Позиция > 0 Тогда
        Результат.Хост = Лев(ХостИПорт, Позиция - 1);
        Результат.Порт = Число(Сред(ХостИПорт, Позиция + 1));
    Иначе
        Результат.Хост = ХостИПорт;
        Если Результат.Схема = "https" Тогда
            Результат.Порт = 443;
        Иначе
            Результат.Порт = 80;
        КонецЕсли;
    КонецЕсли;
    
    Возврат Результат;
    
КонецФункции

// Создает документ в системе документооборота
//
// Параметры:
//  Параметры - Структура - параметры подключения
//  ДанныеДокумента - Структура - данные документа
//
// Возвращаемое значение:
//  Структура - результат создания документа
//
Функция СоздатьДокумент(Параметры, ДанныеДокумента) Экспорт
    
    // Получение токена
    Токен = ПолучитьТокенАвторизации(Параметры);
    Если Не ЗначениеЗаполнено(Токен) Тогда
        Результат = Новый Структура;
        Результат.Вставить("Успех", Ложь);
        Результат.Вставить("ТекстОшибки", "Не удалось получить токен авторизации");
        Возврат Результат;
    КонецЕсли;
    
    Параметры.Вставить("Токен", Токен);
    
    // Формирование JSON
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, ДанныеДокумента);
    ТелоЗапроса = ЗаписьJSON.Закрыть();
    
    // Отправка запроса
    Результат = ВыполнитьЗапросAPI("POST", "/api/documents/", Параметры, ТелоЗапроса);
    
    Возврат Результат;
    
КонецФункции

// Получает список документов
//
// Параметры:
//  Параметры - Структура - параметры подключения
//  Статус - Строка - фильтр по статусу (необязательно)
//
// Возвращаемое значение:
//  Структура - результат запроса со списком документов
//
Функция ПолучитьСписокДокументов(Параметры, Статус = "") Экспорт
    
    Токен = ПолучитьТокенАвторизации(Параметры);
    Если Не ЗначениеЗаполнено(Токен) Тогда
        Результат = Новый Структура;
        Результат.Вставить("Успех", Ложь);
        Результат.Вставить("ТекстОшибки", "Не удалось получить токен авторизации");
        Возврат Результат;
    КонецЕсли;
    
    Параметры.Вставить("Токен", Токен);
    
    Путь = "/api/documents/";
    Если ЗначениеЗаполнено(Статус) Тогда
        Путь = Путь + "?status=" + Статус;
    КонецЕсли;
    
    Результат = ВыполнитьЗапросAPI("GET", Путь, Параметры);
    
    Возврат Результат;
    
КонецФункции

