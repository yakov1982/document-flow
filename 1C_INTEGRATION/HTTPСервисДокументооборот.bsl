//  Пользователь - Строка - пользователь, согласовавший документ
//  Комментарий - Строка - комментарий
//
// Возвращаемое значение:
//  Структура - результат обработки
//
Функция ОбработатьУведомлениеОСогласовании(ДокументСсылка, Статус, Пользователь, Комментарий)
    
    Результат = Новый Структура;
    Результат.Вставить("Успех", Ложь);
    Результат.Вставить("ТекстОшибки", "");
    
    Попытка
        
        // В этом месте можно:
        // 1. Записать информацию в регистр сведений "СтатусыСогласованияДокументов"
        // 2. Изменить статус документа (если есть такой реквизит)
        // 3. Провести документ автоматически
        // 4. Отправить уведомление ответственному пользователю
        
        // Пример записи в регистр сведений (если существует)
        // РегистрыСведений.СтатусыСогласованияСЭД.СоздатьНаборЗаписей()...
        
        // Запись в журнал регистрации
        ЗаписьЖурналаРегистрации(
            "ИнтеграцияДМС.УведомлениеОСогласовании",
            УровеньЖурналаРегистрации.Информация,
            ,
            ДокументСсылка,
            СтрШаблон("Документ %1 согласован пользователем %2 в СЭД. Комментарий: %3",
                Строка(ДокументСсылка),
                Пользователь,
                Комментарий)
        );
        
        // Если документ имеет статус, можно его обновить
        // ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
        // ДокументОбъект.СтатусСогласования = Перечисления.СтатусыСогласования.Согласован;
        // ДокументОбъект.Записать();
        
        Результат.Успех = Истина;
        
    Исключение
        
        Результат.ТекстОшибки = ОписаниеОшибки();
        
        ЗаписьЖурналаРегистрации(
            "ИнтеграцияДМС.УведомлениеОСогласовании",
            УровеньЖурналаРегистрации.Ошибка,
            ,
            ДокументСсылка,
            Результат.ТекстОшибки
        );
        
    КонецПопытки;
    
    Возврат Результат;
    
КонецФункции

