// HTTP-сервис для интеграции с системой документооборота
// Версия: 1.0
// Платформа: 1С:Предприятие 8.3
// 
// Этот сервис позволяет внешним системам (в том числе СЭД) отправлять
// уведомления и данные в 1С:Предприятие

#Область ОбработчикиHTTP

// POST /webhook/document-approved
// Обработчик уведомления о согласовании документа
//
// Тело запроса (JSON):
// {
//   "document_id": 123,
//   "document_guid": "guid-документа-1с",
//   "status": "approved",
//   "approved_by": "username",
//   "comment": "Согласовано"
// }
//
Функция УведомлениеОСогласованииДокумента(Запрос)
    
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json");
    
    Попытка
        
        // Чтение тела запроса
        ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
        
        // Парсинг JSON
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
        ДанныеУведомления = ПрочитатьJSON(ЧтениеJSON);
        ЧтениеJSON.Закрыть();
        
        // Валидация данных
        Если Не ДанныеУведомления.Свойство("document_guid") Тогда
            Возврат СформироватьОшибкуJSON(400, "Отсутствует обязательное поле document_guid");
        КонецЕсли;
        
        // Поиск документа 1С по GUID
        ГУИДДокумента = Новый УникальныйИдентификатор(ДанныеУведомления.document_guid);
        ДокументСсылка = НайтиДокументПоГУИД(ГУИДДокумента);
        
        Если ДокументСсылка = Неопределено Тогда
            Возврат СформироватьОшибкуJSON(404, "Документ не найден в 1С");
        КонецЕсли;
        
        // Обработка уведомления
        Статус = "";
        Если ДанныеУведомления.Свойство("status") Тогда
            Статус = ДанныеУведомления.status;
        КонецЕсли;
        
        Комментарий = "";
        Если ДанныеУведомления.Свойство("comment") Тогда
            Комментарий = ДанныеУведомления.comment;
        КонецЕсли;
        
        СогласовавшийПользователь = "";
        Если ДанныеУведомления.Свойство("approved_by") Тогда
            СогласовавшийПользователь = ДанныеУведомления.approved_by;
        КонецЕсли;
        
        // Обработка согласования документа
        РезультатОбработки = ОбработатьУведомлениеОСогласовании(
            ДокументСсылка,
            Статус,
            СогласовавшийПользователь,
            Комментарий
        );
        
        Если РезультатОбработки.Успех Тогда
            
            РезультатJSON = Новый Структура;
            РезультатJSON.Вставить("success", Истина);
            РезультатJSON.Вставить("message", "Уведомление обработано");
            
            Ответ.УстановитьТелоИзСтроки(ПреобразоватьВJSON(РезультатJSON));
            
        Иначе
            
            Возврат СформироватьОшибкуJSON(500, РезультатОбработки.ТекстОшибки);
            
        КонецЕсли;
        
    Исключение
        
        Возврат СформироватьОшибкуJSON(500, ОписаниеОшибки());
        
    КонецПопытки;
    
    Возврат Ответ;
    
КонецФункции

// POST /webhook/document-rejected
