// Формирует ответ с ошибкой в формате JSON
//
// Параметры:
//  КодОшибки - Число - HTTP код ошибки
//  ТекстОшибки - Строка - описание ошибки
//
// Возвращаемое значение:
//  HTTPСервисОтвет - ответ с ошибкой
//
Функция СформироватьОшибкуJSON(КодОшибки, ТекстОшибки)
    
    Ответ = Новый HTTPСервисОтвет(КодОшибки);
    Ответ.Заголовки.Вставить("Content-Type", "application/json");
    
    ОшибкаJSON = Новый Структура;
    ОшибкаJSON.Вставить("success", Ложь);
    ОшибкаJSON.Вставить("error", ТекстОшибки);
    
    Ответ.УстановитьТелоИзСтроки(ПреобразоватьВJSON(ОшибкаJSON));
    
    Возврат Ответ;
    
КонецФункции

// Преобразует структуру в JSON строку
//
// Параметры:
//  Данные - Структура, Массив - данные для преобразования
//
// Возвращаемое значение:
//  Строка - JSON представление данных
//
Функция ПреобразоватьВJSON(Данные)
    
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Данные);
    
    Возврат ЗаписьJSON.Закрыть();
    
КонецФункции

#КонецОбласти
