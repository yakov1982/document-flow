#Область СлужебныеПроцедурыИФункции

// Ищет документ 1С по уникальному идентификатору
//
// Параметры:
//  ГУИД - УникальныйИдентификатор - идентификатор документа
//
// Возвращаемое значение:
//  ДокументСсылка - найденный документ или Неопределено
//
Функция НайтиДокументПоГУИД(ГУИД)
    
    // Перебираем основные типы документов
    // В реальной конфигурации используйте метаданные или регистр сведений
    // для хранения связи между документами 1С и СЭД
    
    МассивТиповДокументов = Новый Массив;
    МассивТиповДокументов.Добавить(Тип("ДокументСсылка.СчетНаОплату"));
    МассивТиповДокументов.Добавить(Тип("ДокументСсылка.РеализацияТоваровУслуг"));
    МассивТиповДокументов.Добавить(Тип("ДокументСсылка.ПоступлениеТоваровУслуг"));
    // Добавьте другие типы документов по необходимости
    
    Для Каждого ТипДокумента Из МассивТиповДокументов Цикл
        
        Попытка
            
            МенеджерДокумента = Документы[ТипДокумента.Имя];
            ДокументСсылка = МенеджерДокумента.ПолучитьСсылку(ГУИД);
            
            Если ОбщегоНазначения.СсылкаСуществует(ДокументСсылка) Тогда
                Возврат ДокументСсылка;
            КонецЕсли;
            
        Исключение
            // Продолжаем поиск
        КонецПопытки;
        
    КонецЦикла;
    
    Возврат Неопределено;
    
КонецФункции

// Обрабатывает уведомление о согласовании документа
//
// Параметры:
//  ДокументСсылка - ДокументСсылка - ссылка на документ
